# ============================================================
#  CONFIGURACION DE simple-video-bot
#  Copia este archivo a ".env" y rellena los valores.
#  NUNCA subas el .env real al repositorio (esta en .gitignore).
#  En GitHub Actions, estos valores van como "Secrets", no en el .env.
# ============================================================

# --- Modo de ejecucion ---
# true = simulado (no gasta creditos, no publica nada). Ideal para probar.
# false = real (genera video con Agnes y publica de verdad).
DRY_RUN=true

# --- Agnes AI (generacion de video + guion) ---
AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com   (opcional, ya es el valor por defecto)
# AGNES_POLL_INTERVAL_MS=15000                 (opcional; bajar a 8000 si tenes Token Plan)

# --- Voz (Edge TTS) ---
# TTS_VOICE=es-MX-JorgeNeural                  (opcional, ya es el valor por defecto)

# --- Opciones de video ---
# SEGMENT_COUNT=6            (segmentos por Reel; las Historias siempre usan 1)
# ADD_SUBTITLES=true
# ADD_WATERMARK=true
# WATERMARK_PATH=./assets/logo.png

# ============================================================
#  CREDENCIALES POR RED SOCIAL
#  --------------------------------------------------------
#  IMPORTANTE: los valores de abajo se leen SOLO cuando NO existe
#  accounts.json (modo cuenta unica). Como vos usas DOS canales,
#  las credenciales reales van en accounts.json (ver accounts.example.json),
#  y estas variables quedan como respaldo/mono-cuenta.
#
#  DATOS NO SECRETOS (para que los tengas a mano al regenerar tokens):
#    - Curious4D  Page ID: 1193866613810828
#    - Hipotesis4D Page ID: 1220213537839259
#    - Meta App ID:         2780399452339019
#    - Instagram usa el mismo Page ID de su Facebook vinculado.
# ============================================================

# --- Meta (Facebook + Instagram), modo mono-cuenta ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# --- YouTube ---
# YOUTUBE_CREDENTIALS_PATH=./youtube-credentials.json
# YOUTUBE_TOKEN_PATH=./youtube-token.json
# YOUTUBE_PRIVACY=public

# --- TikTok (opcional; pendiente de aprobacion de API) ---
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_TOKEN_PATH=./tiktok-token.json
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
